#!/bin/sh
DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Ensure binaries are built
if [ ! -f "$DIR/build/http_server" ]; then
    make -C "$DIR" >/dev/null 2>&1
fi

# Suppress kernel TCP RSTs for ports without kernel sockets
iptables -C OUTPUT -p tcp --tcp-flags RST RST -j DROP 2>/dev/null || \
    iptables -A OUTPUT -p tcp --tcp-flags RST RST -j DROP 2>/dev/null

exec "$DIR/build/http_server" "$@"
